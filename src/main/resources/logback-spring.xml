<?xml version="1.0" encoding="UTF-8"?>
<!--
    自定义 logback 配置：Spring Boot 原生的 logging.file.name 不支持日期占位符，
    文件名要用 %d 时间戳就必须自己写 RollingFileAppender。
    下面的各项参数仍从 application.yaml 读取，调配置不用改这里。
-->
<configuration>

    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wEx" class="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>
    <springProperty scope="context" name="LOG_HOME" source="logging.file.path" defaultValue="logs"/>
    <springProperty scope="context" name="CONSOLE_PATTERN" source="logging.pattern.console"
                   defaultValue="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%wEx"/>
    <springProperty scope="context" name="FILE_PATTERN" source="logging.pattern.file"
                   defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%15.15t] %-40.40logger{39} : %m%n%wEx"/>
    <springProperty scope="context" name="CONSOLE_CHARSET" source="logging.charset.console" defaultValue="UTF-8"/>
    <springProperty scope="context" name="FILE_CHARSET" source="logging.charset.file" defaultValue="UTF-8"/>
    <springProperty scope="context" name="MAX_FILE_SIZE" source="logging.logback.rollingpolicy.max-file-size" defaultValue="10MB"/>
    <springProperty scope="context" name="MAX_HISTORY" source="logging.logback.rollingpolicy.max-history" defaultValue="30"/>
    <springProperty scope="context" name="TOTAL_SIZE_CAP" source="logging.logback.rollingpolicy.total-size-cap" defaultValue="1GB"/>
    <springProperty scope="context" name="CLEAN_HISTORY_ON_START" source="logging.logback.rollingpolicy.clean-history-on-start" defaultValue="false"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>${CONSOLE_CHARSET}</charset>
        </encoder>
    </appender>

    <!--
        不写 <file> 元素：这样当前写入的文件名由 fileNamePattern 里的 %d 推导出来，
        形如 test19.2026-09-15.0.log；跨天会自动新建文件，超过 max-file-size 则递增后缀 %i。
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!--
            只落盘 ERROR 级别：LevelFilter 命中 ERROR 直接放行，其余级别直接丢弃。
            控制台 CONSOLE 不挂这个过滤器，所以终端仍按 logging.level.* 正常输出 info/debug。
            注意：logger 的级别判定在 appender 之前，只有先通过 root/包级别（这里是 INFO）的事件才会走到这里。
        -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>${CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>${FILE_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 具体日志级别仍由 application.yaml 的 logging.level.* 控制 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
